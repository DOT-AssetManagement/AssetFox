<configuration>
    <system.webServer>
        <!-- indicates that the app.js file is a node.js application
        to be handled by the iisnode module -->
        <handlers>
            <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
        </handlers>
        <rewrite>
            <rules>
                <rule name="sendToNode">
                    <match url="/*" />
                    <action type="Rewrite" url="app.js" />
                </rule>
            </rules>
        </rewrite>
		<iisnode node_env="production" nodeProcessCommandLine="C:\Program Files\nodejs\node.exe --max-http-header-size=80000" />
    </system.webServer>
	<appSettings>
    <add key="npm_package_security" value="B2C" />
  </appSettings>
</configuration>